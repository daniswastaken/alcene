	(text "Pin functions (Espressif docs):\nTX = U0TXD / GPIO43, RX = U0RXD / GPIO44\nGPIO20 = USB_D+, GPIO19 = USB_D- (native USB)\nGPIO38 = RGB LED (v1.1); GPIO48 = RGB LED (v1.0)\nGPIO0 = Boot strap, RST = EN / CHIP_PU\nGPIO35/36/37 reserved on octal flash/PSRAM modules\nPower: 5V + GND, or 3V3 + GND"
		(exclude_from_sim no)
		(at 101 55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
